<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="sylius.router.localized"
                 class="Sylius\Bundle\CoreBundle\Routing\LocalizedRouter"
                 decorates="router">
            <argument type="service" id="sylius.router.localized.inner" />
            <argument type="service" id="sylius.locale.denormalizer" />
        </service>

    </services>
</container>
